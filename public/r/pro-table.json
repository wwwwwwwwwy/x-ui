{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "pro-table",
  "title": "Pro Table",
  "description": "A compact table component with typed columns.",
  "files": [
    {
      "path": "registry/default/pro-table/ProTable.vue",
      "content": "<template>\n  <div class=\"overflow-hidden rounded-lg border border-slate-200 bg-white\">\n    <table class=\"w-full border-collapse text-sm\">\n      <thead class=\"bg-slate-50 text-left text-slate-600\">\n        <tr>\n          <th\n            v-for=\"column in columns\"\n            :key=\"column.key\"\n            class=\"border-b border-slate-200 px-4 py-3 font-medium\"\n          >\n            {{ column.title }}\n          </th>\n        </tr>\n      </thead>\n      <tbody>\n        <tr v-if=\"rows.length === 0\">\n          <td :colspan=\"columns.length\" class=\"px-4 py-8 text-center text-slate-500\">\n            No data\n          </td>\n        </tr>\n        <tr v-for=\"(row, rowIndex) in rows\" :key=\"rowIndex\" class=\"border-b border-slate-100 last:border-0\">\n          <td v-for=\"column in columns\" :key=\"column.key\" class=\"px-4 py-3 text-slate-700\">\n            {{ row[column.key] }}\n          </td>\n        </tr>\n      </tbody>\n    </table>\n  </div>\n</template>\n\n<script setup lang=\"ts\">\nexport interface ProTableColumn {\n  key: string\n  title: string\n}\n\ndefineProps<{\n  columns: ProTableColumn[]\n  rows: Record<string, unknown>[]\n}>()\n</script>\n",
      "type": "registry:ui"
    },
    {
      "path": "registry/default/pro-table/index.ts",
      "content": "export { default as ProTable } from './ProTable.vue'\nexport type { ProTableColumn } from './ProTable.vue'\n",
      "type": "registry:ui"
    }
  ],
  "type": "registry:ui"
}